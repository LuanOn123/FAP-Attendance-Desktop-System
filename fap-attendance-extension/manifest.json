{
  "manifest_version": 3,
  "name": "FAP Attendance Connector",
  "version": "1.3.0",
  "description": "Connect FAP lecturer attendance pages with FAP Attendance Desktop System.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://fap.fpt.edu.vn/*",
    "http://127.0.0.1:8765/*",
    "file:///*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://fap.fpt.edu.vn/*",
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/fapAttendanceScanner.js",
        "content/fapAttendanceWriter.js",
        "content/fapSyncPanel.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background/serviceWorker.js"
  }
}
